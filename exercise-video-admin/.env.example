# Server (copy to server/.env)
PORT=8787
CORS_ORIGINS=http://localhost:5173

FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccount.json
FIRESTORE_EXERCISES_COLLECTION=exercises
FIRESTORE_CATEGORIES_COLLECTION=categories

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

ADMIN_API_KEY=change-me-long-random
PUBLIC_API_KEY=

# Aura AI coach — Cloudflare Workers AI (primary) + OpenRouter (backup)
# Cloudflare: Workers AI dashboard → Use REST API → create token + copy Account ID
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Default Cloudflare model; admins can override in Firestore field cloudflareModel
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-3b-instruct
# Primary provider when Firestore aiProvider is unset: cloudflare | openrouter
AI_PROVIDER_DEFAULT=cloudflare
# OpenRouter (backup / optional primary — server-side only)
OPENROUTER_API_KEY=
# Default OpenRouter model; admins can override in Firestore field openRouterModel
OPENROUTER_MODEL=openai/gpt-4o-mini
# Firestore document for editable coach prompt + UI strings
FIRESTORE_AI_COACH_COLLECTION=trakkit_admin_settings
FIRESTORE_AI_COACH_DOC=ai_coach

# Web (copy to web/.env)
VITE_API_URL=http://localhost:8787
